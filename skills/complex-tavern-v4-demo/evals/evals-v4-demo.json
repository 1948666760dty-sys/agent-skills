{
  "version": "4.0.0-demo.2",
  "type": "contract-and-scenario-regression",
  "note": "These tests verify the Skill contract/rules, not a real vector DB or branch persistence runtime.",
  "cases": [
    {
      "id": "V4-001",
      "cat": "activation",
      "scenario": "普通开始复杂酒馆",
      "expect": "must route to stable v3, not v4 demo"
    },
    {
      "id": "V4-002",
      "cat": "activation",
      "scenario": "复杂酒馆 4.0 demo",
      "expect": "load demo canonical and show demo version"
