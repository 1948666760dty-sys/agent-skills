    },
    {
      "id": "V4-041",
      "cat": "relationship",
      "scenario": "confirmed couple",
      "expect": "v3.7 relationship-stage protections remain"
    },
    {
      "id": "V4-042",
      "cat": "truthfulness",
      "scenario": "feature capability unavailable",
