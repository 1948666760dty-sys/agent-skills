    {
      "id": "V4-019",
      "cat": "calendar",
      "scenario": "23:55 to 00:10",
      "expect": "real day boundary update"
    },
    {
      "id": "V4-020",
      "cat": "calendar",
      "scenario": "second day afternoon",
