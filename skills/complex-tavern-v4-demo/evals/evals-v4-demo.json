    },
    {
      "id": "V4-034",
      "cat": "entity_card",
      "scenario": "with_history export",
      "expect": "still exclude private state unless explicitly authorized audit/GM export"
    },
    {
      "id": "V4-035",
      "cat": "debugger",
      "scenario": "why does NPC know X",
